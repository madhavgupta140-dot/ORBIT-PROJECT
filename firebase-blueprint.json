{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile of an Orbit member",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User UID matching auth.uid",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Display name of the user",
          "minLength": 1,
          "maxLength": 80
        },
        "username": {
          "type": "string",
          "description": "Normalized unique handle without @ symbol",
          "minLength": 2,
          "maxLength": 30,
          "pattern": "^[a-z0-9_]+$"
        },
        "avatar": {
          "type": "string",
          "description": "URL to user profile picture or empty string",
          "maxLength": 2048
        },
        "banner": {
          "type": "string",
          "description": "URL to user profile header banner image or empty string",
          "maxLength": 2048
        },
        "bio": {
          "type": "string",
          "description": "User biography or personal signal statement",
          "maxLength": 300
        },
        "countryCode": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2 country code (e.g. IN, US, GB)",
          "maxLength": 10
        },
        "countryName": {
          "type": "string",
          "description": "Official display country name",
          "maxLength": 100
        },
        "location": {
          "type": "string",
          "description": "User country display name or location",
          "maxLength": 100
        },
        "website": {
          "type": "string",
          "description": "Personal website or portfolio link",
          "maxLength": 200
        },
        "interests": {
          "type": "array",
          "description": "List of topic tags of interest (max 12)",
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "joinedDate": {
          "type": "string",
          "description": "Human-readable joined month/year",
          "maxLength": 40
        },
        "verified": {
          "type": "boolean",
          "description": "Whether the identity is officially verified"
        },
        "trustLevel": {
          "type": "string",
          "description": "Algorithmic or member trust tier",
          "enum": ["Private", "Emerging", "Established", "Trusted"]
        },
        "followerCount": {
          "type": "number",
          "description": "Number of users following this profile"
        },
        "followingCount": {
          "type": "number",
          "description": "Number of users this profile follows"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp or server timestamp string",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp or server timestamp string",
          "maxLength": 40
        },
        "profileDiscoverability": {
          "type": "string",
          "description": "Who can discover the user profile",
          "enum": ["Public", "FollowersOnly", "Private"]
        },
        "defaultPostVisibility": {
          "type": "string",
          "description": "Default audience for newly created posts",
          "enum": ["Public", "Followers", "Private"]
        },
        "directMessageReach": {
          "type": "string",
          "description": "Who can send direct messages to the user",
          "enum": ["Everyone", "Followers", "None"]
        },
        "directMessagesReach": {
          "type": "string",
          "description": "Who can send direct messages to the user",
          "enum": ["Everyone", "Followers", "None"]
        },
        "likesNotifications": {
          "type": "boolean",
          "description": "Notification trigger for likes and reactions"
        },
        "mentionsNotifications": {
          "type": "boolean",
          "description": "Notification trigger for mentions and replies"
        },
        "followerNotifications": {
          "type": "boolean",
          "description": "Notification trigger for new followers"
        },
        "directMessageNotifications": {
          "type": "boolean",
          "description": "Notification trigger for direct messages"
        },
        "storyNotifications": {
          "type": "boolean",
          "description": "Notification trigger for story replies and activity"
        },
        "recommendationNotifications": {
          "type": "boolean",
          "description": "Notification trigger for curated recommendations"
        },
        "notifications": {
          "type": "object",
          "description": "Notification preference triggers",
          "properties": {
            "likes": { "type": "boolean" },
            "mentions": { "type": "boolean" },
            "followers": { "type": "boolean" },
            "messages": { "type": "boolean" },
            "storyReplies": { "type": "boolean" },
            "recommendations": { "type": "boolean" },
            "comments": { "type": "boolean" },
            "follows": { "type": "boolean" },
            "storyActivity": { "type": "boolean" }
          }
        },
        "reducedMotion": {
          "type": "boolean",
          "description": "Whether UI motion and animations are reduced"
        },
        "compactView": {
          "type": "boolean",
          "description": "Whether compact layout mode is enabled"
        },
        "compactMode": {
          "type": "boolean",
          "description": "Whether compact layout mode is enabled"
        }
      },
      "required": ["id", "name", "username"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Private Personally Identifiable Information (PII) isolated from public profile",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User account email",
          "maxLength": 150
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp",
          "maxLength": 40
        }
      }
    },
    "UsernameMapping": {
      "title": "UsernameMapping",
      "description": "Global unique username registry mapping normalized handles to UIDs",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "UID of the owning user",
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "description": "Normalized username",
          "minLength": 2,
          "maxLength": 30,
          "pattern": "^[a-z0-9_]+$"
        },
        "createdAt": {
          "type": "string",
          "description": "Registration timestamp",
          "maxLength": 40
        }
      },
      "required": ["uid", "username"]
    },
    "Post": {
      "title": "Post",
      "description": "An individual signal transmission published to Orbit",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique post ID",
          "maxLength": 128
        },
        "authorId": {
          "type": "string",
          "description": "UID of the author",
          "maxLength": 128
        },
        "authorName": {
          "type": "string",
          "description": "Snapshot of author display name",
          "maxLength": 80
        },
        "authorUsername": {
          "type": "string",
          "description": "Snapshot of author handle",
          "maxLength": 30
        },
        "authorAvatar": {
          "type": "string",
          "description": "Snapshot of author avatar URL",
          "maxLength": 2048
        },
        "authorVerified": {
          "type": "boolean",
          "description": "Snapshot of verification state"
        },
        "text": {
          "type": "string",
          "description": "Body text of the post",
          "maxLength": 2000
        },
        "media": {
          "type": "string",
          "description": "URL of attached media",
          "maxLength": 2048
        },
        "mediaType": {
          "type": "string",
          "description": "Media MIME type category",
          "enum": ["image", "video"]
        },
        "mediaName": {
          "type": "string",
          "description": "File name of attached media",
          "maxLength": 120
        },
        "visibility": {
          "type": "string",
          "description": "Audience visibility scope",
          "enum": ["Public", "Followers", "Private"]
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp string",
          "maxLength": 40
        },
        "likes": {
          "type": "number",
          "description": "Aggregated likes counter"
        },
        "reposts": {
          "type": "number",
          "description": "Aggregated reposts counter"
        },
        "views": {
          "type": "number",
          "description": "Impressions view counter"
        },
        "tags": {
          "type": "array",
          "description": "Topic hashtags",
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether pinned to top of profile"
        }
      },
      "required": ["authorId", "authorName", "authorUsername", "text", "visibility"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Comment on a post",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Comment ID",
          "maxLength": 128
        },
        "authorId": {
          "type": "string",
          "description": "UID of commenter",
          "maxLength": 128
        },
        "authorName": {
          "type": "string",
          "description": "Commenter display name",
          "maxLength": 80
        },
        "authorUsername": {
          "type": "string",
          "description": "Commenter handle",
          "maxLength": 30
        },
        "authorAvatar": {
          "type": "string",
          "description": "Commenter avatar",
          "maxLength": 2048
        },
        "text": {
          "type": "string",
          "description": "Comment text",
          "minLength": 1,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp",
          "maxLength": 40
        },
        "likes": {
          "type": "number",
          "description": "Likes on comment"
        }
      },
      "required": ["authorId", "authorName", "authorUsername", "text"]
    },
    "Story": {
      "title": "Story",
      "description": "Ephemeral 24-hour visual transmission (Story V2)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Story unique ID",
          "maxLength": 128
        },
        "authorId": {
          "type": "string",
          "description": "Author UID",
          "maxLength": 128
        },
        "authorUid": {
          "type": "string",
          "description": "Author UID",
          "maxLength": 128
        },
        "authorName": {
          "type": "string",
          "description": "Author display name",
          "maxLength": 80
        },
        "authorUsername": {
          "type": "string",
          "description": "Author handle",
          "maxLength": 30
        },
        "authorAvatar": {
          "type": "string",
          "description": "Author avatar URL",
          "maxLength": 2048
        },
        "authorVerified": {
          "type": "boolean",
          "description": "Author verified status"
        },
        "media": {
          "type": "string",
          "description": "Story media asset URL",
          "maxLength": 2048
        },
        "mediaUrl": {
          "type": "string",
          "description": "Story media download URL",
          "maxLength": 2048
        },
        "storagePath": {
          "type": "string",
          "description": "Firebase Storage path (stories/{uid}/{storyId}/{filename})",
          "maxLength": 1024
        },
        "mediaType": {
          "type": "string",
          "description": "Media type",
          "enum": ["image", "video"]
        },
        "caption": {
          "type": "string",
          "description": "Optional story caption",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 40
        },
        "expiresAt": {
          "type": "string",
          "description": "Expiration timestamp (+24h)",
          "maxLength": 40
        },
        "expiresAtMs": {
          "type": "number",
          "description": "Expiration time in epoch milliseconds"
        },
        "viewers": {
          "type": "array",
          "description": "List of user UIDs who have viewed this story",
          "items": { "type": "string" }
        },
        "reactions": {
          "type": "object",
          "description": "Map of emoji to reaction count",
          "additionalProperties": { "type": "number" }
        },
        "isDeleted": {
          "type": "boolean",
          "description": "Soft delete or deletion flag"
        }
      },
      "required": ["authorId", "authorName", "authorUsername", "media", "mediaType"]
    },
    "StoryViewer": {
      "title": "StoryViewer",
      "description": "Viewer presence record for a story",
      "type": "object",
      "properties": {
        "viewerUid": {
          "type": "string",
          "description": "UID of the member viewing the story",
          "maxLength": 128
        },
        "viewerName": {
          "type": "string",
          "description": "Display name of viewer",
          "maxLength": 80
        },
        "viewerUsername": {
          "type": "string",
          "description": "Handle of viewer",
          "maxLength": 30
        },
        "viewerAvatar": {
          "type": "string",
          "description": "Avatar URL of viewer",
          "maxLength": 2048
        },
        "viewedAt": {
          "type": "string",
          "description": "Timestamp when viewed",
          "maxLength": 40
        }
      },
      "required": ["viewerUid", "viewerName", "viewerUsername"]
    },
    "StoryReaction": {
      "title": "StoryReaction",
      "description": "Real-time emoji reaction on a story",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the member reacting",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "description": "Display name of reacting member",
          "maxLength": 80
        },
        "userUsername": {
          "type": "string",
          "description": "Handle of reacting member",
          "maxLength": 30
        },
        "userAvatar": {
          "type": "string",
          "description": "Avatar URL of reacting member",
          "maxLength": 2048
        },
        "emoji": {
          "type": "string",
          "description": "Reaction emoji character",
          "enum": ["❤️", "🔥", "😂", "😮", "😢"]
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when reacted",
          "maxLength": 40
        }
      },
      "required": ["userId", "emoji"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct message thread between participants",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Conversation ID",
          "maxLength": 128
        },
        "participantIds": {
          "type": "array",
          "description": "UIDs of the 2 participants",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "pinned": {
          "type": "boolean",
          "description": "Whether the conversation is pinned by participant"
        },
        "pinnedAt": {
          "type": "string",
          "description": "Timestamp when pinned",
          "maxLength": 40
        },
        "pinnedBy": {
          "type": "object",
          "description": "Map of user IDs to pinned boolean status"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last message timestamp",
          "maxLength": 40
        }
      },
      "required": ["participantIds"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual direct message within a conversation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message ID",
          "maxLength": 128
        },
        "senderId": {
          "type": "string",
          "description": "UID of sender",
          "maxLength": 128
        },
        "receiverId": {
          "type": "string",
          "description": "UID of receiver",
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "description": "Message content",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp",
          "maxLength": 40
        },
        "isRead": {
          "type": "boolean",
          "description": "Read status"
        },
        "isForwarded": {
          "type": "boolean",
          "description": "Whether message was forwarded from another conversation"
        },
        "reactions": {
          "type": "object",
          "description": "Emoji reactions map: emoji -> array of user IDs"
        }
      },
      "required": ["senderId", "receiverId", "text"]
    },
    "OrbitNotification": {
      "title": "OrbitNotification",
      "description": "Real-time user notification event",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Notification ID",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "description": "Notification category",
          "enum": ["like", "comment", "follow", "repost", "message", "system"]
        },
        "title": {
          "type": "string",
          "description": "Summary title",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Detailed event text",
          "maxLength": 300
        },
        "targetId": {
          "type": "string",
          "description": "Target post or conversation ID",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Event timestamp",
          "maxLength": 40
        },
        "isRead": {
          "type": "boolean",
          "description": "Read status"
        }
      },
      "required": ["type", "title", "description"]
    },
    "PostLike": {
      "title": "PostLike",
      "description": "Like record on post",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the liking user",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp",
          "maxLength": 40
        }
      },
      "required": ["userId"]
    },
    "PostRepost": {
      "title": "PostRepost",
      "description": "Repost record on post",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the reposting user",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp",
          "maxLength": 40
        }
      },
      "required": ["userId"]
    },
    "UserLikedPost": {
      "title": "UserLikedPost",
      "description": "User liked post reference",
      "type": "object",
      "properties": {
        "postId": {
          "type": "string",
          "description": "Target post ID",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp",
          "maxLength": 40
        }
      },
      "required": ["postId"]
    },
    "UserRepost": {
      "title": "UserRepost",
      "description": "User repost reference",
      "type": "object",
      "properties": {
        "postId": {
          "type": "string",
          "description": "Target post ID",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp",
          "maxLength": 40
        }
      },
      "required": ["postId"]
    },
    "SavedPost": {
      "title": "SavedPost",
      "description": "User bookmarked post reference document",
      "type": "object",
      "properties": {
        "postId": {
          "type": "string",
          "description": "Target post ID",
          "maxLength": 128
        },
        "savedAt": {
          "type": "string",
          "description": "Timestamp when post was bookmarked",
          "maxLength": 40
        }
      },
      "required": ["postId"]
    },
    "Follow": {
      "title": "Follow",
      "description": "One follow relationship mapping a follower UID to a following UID",
      "type": "object",
      "properties": {
        "followerUid": {
          "type": "string",
          "description": "UID of the user who initiated the follow",
          "maxLength": 128
        },
        "followingUid": {
          "type": "string",
          "description": "UID of the target user being followed",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of follow initiation",
          "maxLength": 40
        }
      },
      "required": ["followerUid", "followingUid"]
    },
    "GroupChat": {
      "title": "GroupChat",
      "description": "Multi-member collaborative group conversation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique group ID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Display name of the group",
          "minLength": 1,
          "maxLength": 80
        },
        "photoURL": {
          "type": "string",
          "description": "URL to group avatar icon or image",
          "maxLength": 2048
        },
        "description": {
          "type": "string",
          "description": "Brief group description or topic",
          "maxLength": 300
        },
        "ownerUid": {
          "type": "string",
          "description": "UID of the group creator and primary administrator",
          "maxLength": 128
        },
        "admins": {
          "type": "array",
          "description": "List of administrator UIDs",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "members": {
          "type": "array",
          "description": "List of all participant member UIDs (min 2, max 100)",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when group was created",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of latest group activity",
          "maxLength": 40
        },
        "lastMessage": {
          "type": "string",
          "description": "Preview snippet of last message sent",
          "maxLength": 500
        },
        "lastMessageAt": {
          "type": "string",
          "description": "Timestamp of last message",
          "maxLength": 40
        },
        "lastSenderUid": {
          "type": "string",
          "description": "UID of last message sender",
          "maxLength": 128
        },
        "isGroup": {
          "type": "boolean",
          "description": "Discriminator flag identifying document as a group"
        }
      },
      "required": ["id", "name", "ownerUid", "admins", "members", "isGroup"]
    },
    "GroupChatMessage": {
      "title": "GroupChatMessage",
      "description": "Individual message sent within a group conversation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique message ID",
          "maxLength": 128
        },
        "senderUid": {
          "type": "string",
          "description": "UID of sender",
          "maxLength": 128
        },
        "senderName": {
          "type": "string",
          "description": "Cached display name of sender",
          "maxLength": 80
        },
        "senderUsername": {
          "type": "string",
          "description": "Cached handle of sender",
          "maxLength": 40
        },
        "senderAvatar": {
          "type": "string",
          "description": "Cached avatar URL of sender",
          "maxLength": 2048
        },
        "text": {
          "type": "string",
          "description": "Message text content",
          "maxLength": 2000
        },
        "mediaUrl": {
          "type": "string",
          "description": "Optional download URL of attached media",
          "maxLength": 2048
        },
        "mediaType": {
          "type": "string",
          "description": "MIME type category (image, video, document)",
          "maxLength": 50
        },
        "mediaName": {
          "type": "string",
          "description": "Optional original file name of attached media",
          "maxLength": 256
        },
        "replyTo": {
          "type": "string",
          "description": "Optional ID of message being replied to",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of message creation",
          "maxLength": 40
        },
        "edited": {
          "type": "boolean",
          "description": "Whether message was edited"
        },
        "deletedFor": {
          "type": "array",
          "description": "List of user UIDs who deleted message for themselves",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "isSystem": {
          "type": "boolean",
          "description": "Whether message is an automated system announcement"
        }
      },
      "required": ["id", "senderUid"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Public user profile document identified by auth.uid"
    },
    "/users/{userId}/private/info": {
      "schema": "UserPrivateInfo",
      "description": "Isolated private PII data readable only by the owning user"
    },
    "/users/{userId}/likedPosts/{postId}": {
      "schema": "UserLikedPost",
