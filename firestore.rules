rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL SECURITY HELPERS & PRIMITIVES
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsername(handle) {
      return handle is string && handle.size() >= 2 && handle.size() <= 30 && handle.matches('^[a-z0-9_]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // USERS COLLECTION (/users/{userId})
    // =========================================================================

    function isValidUserProfile(data) {
      return data.id is string && data.id == request.auth.uid &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             isValidUsername(data.username) &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 2000000)) &&
             (!('banner' in data) || (data.banner is string && data.banner.size() <= 2000000)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
             (!('countryCode' in data) || (data.countryCode is string && data.countryCode.size() <= 10)) &&
             (!('countryName' in data) || (data.countryName is string && data.countryName.size() <= 100)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 100)) &&
             (!('website' in data) || (data.website is string && data.website.size() <= 200)) &&
             (!('interests' in data) || (data.interests is list && data.interests.size() <= 12)) &&
             (!('joinedDate' in data) || (data.joinedDate is string && data.joinedDate.size() <= 40)) &&
             (!('verified' in data) || data.verified is bool) &&
             (!('trustLevel' in data) || (data.trustLevel in ['Private', 'Emerging', 'Established', 'Trusted'])) &&
             (!('profileDiscoverability' in data) || (data.profileDiscoverability in ['Public', 'FollowersOnly', 'Private'])) &&
             (!('defaultPostVisibility' in data) || (data.defaultPostVisibility in ['Public', 'Followers', 'Private'])) &&
             (!('directMessagesReach' in data) || (data.directMessagesReach in ['Everyone', 'Followers', 'None'])) &&
             (!('notifications' in data) || data.notifications is map) &&
             (!('reducedMotion' in data) || data.reducedMotion is bool) &&
             (!('compactView' in data) || data.compactView is bool) &&
             (!('compactMode' in data) || data.compactMode is bool) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    match /users/{userId} {
      allow get, list: if true;

      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());

      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().username == existing().username;

      allow delete: if isOwner(userId);

      // PII Isolation Subcollection (Private info: email)
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Notifications Subcollection
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) || (isSignedIn() && incoming().type in ['like', 'comment', 'follow', 'repost', 'message', 'system']);
      }

      // Liked Posts Subcollection
      match /likedPosts/{postId} {
        allow read, write: if isOwner(userId);
      }

      // Reposts Subcollection
      match /reposts/{postId} {
        allow read, write: if isOwner(userId);
      }

      // Saved Posts Subcollection
      match /savedPosts/{postId} {
        allow read, write: if isOwner(userId);
      }

      // Following Subcollection
      match /following/{targetUserId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // =========================================================================
    // USENAMES REGISTRY (/usernames/{username})
    // =========================================================================

    match /usernames/{username} {
      allow get, list: if true;
      allow create: if isSignedIn() &&
                       isValidUsername(username) &&
                       incoming().uid == request.auth.uid &&
                       incoming().username == username;
      allow update: if isSignedIn() &&
                       isValidUsername(username) &&
                       existing().uid == request.auth.uid &&
                       incoming().uid == request.auth.uid;
      allow delete: if isSignedIn() &&
                       isValidUsername(username) &&
                       existing().uid == request.auth.uid;
    }

    // =========================================================================
    // POSTS COLLECTION (/posts/{postId})
    // =========================================================================

    function isValidPost(data) {
      return ((('authorId' in data) && data.authorId is string && data.authorId == request.auth.uid) ||
              (('authorUid' in data) && data.authorUid is string && data.authorUid == request.auth.uid)) &&
             ((('authorName' in data) && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80) ||
              (('displayName' in data) && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80)) &&
             ((('authorUsername' in data) && isValidUsername(data.authorUsername)) ||
              (('username' in data) && isValidUsername(data.username))) &&
             data.text is string && data.text.size() <= 2000 &&
             data.visibility in ['Public', 'Followers', 'Private'] &&
             (!('media' in data) || (data.media is string && data.media.size() <= 2000000)) &&
             (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 2000000)) &&
             (!('mediaType' in data) || (data.mediaType in ['image', 'video'])) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 10));
    }

    match /posts/{postId} {
      allow get, list: if true;

      allow create: if isSignedIn() && isValidId(postId) && isValidPost(incoming());

      allow update: if isSignedIn() && isValidId(postId) && (
        // Author updating their post
        (((existing().authorId == request.auth.uid) || (existing().authorUid == request.auth.uid)) &&
         isValidPost(incoming())) ||
        // Any signed-in user updating engagement counters via transactions (likes, likeCount, reposts, repostCount, commentCount, comments, views, shares)
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likeCount', 'reposts', 'repostCount', 'commentCount', 'comments', 'views', 'shares']) &&
         (!('likes' in incoming()) || (incoming().likes is number && incoming().likes >= 0)) &&
         (!('likeCount' in incoming()) || (incoming().likeCount is number && incoming().likeCount >= 0)) &&
         (!('reposts' in incoming()) || (incoming().reposts is number && incoming().reposts >= 0)) &&
         (!('repostCount' in incoming()) || (incoming().repostCount is number && incoming().repostCount >= 0)) &&
         (!('commentCount' in incoming()) || (incoming().commentCount is number && incoming().commentCount >= 0)) &&
         (!('views' in incoming()) || (incoming().views is number && incoming().views >= 0)) &&
         (!('shares' in incoming()) || (incoming().shares is number && incoming().shares >= 0)))
      );

      allow delete: if isSignedIn() && isValidId(postId) &&
                       ((existing().authorId == request.auth.uid) || (existing().authorUid == request.auth.uid));

      // Post Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidId(commentId) &&
                         (incoming().authorId == request.auth.uid || incoming().authorUid == request.auth.uid) &&
                         incoming().text is string && incoming().text.size() >= 1 && incoming().text.size() <= 1000;
        allow update, delete: if isSignedIn() && (existing().authorId == request.auth.uid || existing().authorUid == request.auth.uid);
      }

      // Post Likes Subcollection
      match /likes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      // Post Reposts Subcollection
      match /reposts/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // =========================================================================
    // POST LIKES & REPOSTS TOP-LEVEL COLLECTIONS
    // =========================================================================

    match /postLikes/{likeId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(likeId) &&
                       ((('userId' in incoming()) && incoming().userId == request.auth.uid) ||
                        (('userUid' in incoming()) && incoming().userUid == request.auth.uid));
      allow delete: if isSignedIn() && isValidId(likeId) &&
                       ((('userId' in existing()) && existing().userId == request.auth.uid) ||
                        (('userUid' in existing()) && existing().userUid == request.auth.uid) ||
                        likeId.matches('.*_' + request.auth.uid));
    }

    match /postReposts/{repostId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(repostId) &&
                       ((('userId' in incoming()) && incoming().userId == request.auth.uid) ||
                        (('userUid' in incoming()) && incoming().userUid == request.auth.uid));
      allow delete: if isSignedIn() && isValidId(repostId) &&
                       ((('userId' in existing()) && existing().userId == request.auth.uid) ||
                        (('userUid' in existing()) && existing().userUid == request.auth.uid) ||
                        repostId.matches('.*_' + request.auth.uid));
    }

    // =========================================================================
    // STORIES COLLECTION (/stories/{storyId})
    // =========================================================================

    function isValidStory(data) {
      return data.authorId is string && data.authorId == request.auth.uid &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             isValidUsername(data.authorUsername) &&
             data.media is string && data.media.size() <= 2000000 &&
             data.mediaType in ['image', 'video'] &&
             (!('caption' in data) || (data.caption is string && data.caption.size() <= 300));
    }

    match /stories/{storyId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(storyId) && isValidStory(incoming());
      allow update, delete: if isSignedIn() && isValidId(storyId) && existing().authorId == request.auth.uid;
    }

    // =========================================================================
    // CONVERSATIONS & DIRECT MESSAGES (/conversations/{conversationId})
    // =========================================================================

    match /conversations/{conversationId} {
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() &&
                       isValidId(conversationId) &&
                       incoming().participantIds is list &&
                       incoming().participantIds.size() == 2 &&
                       request.auth.uid in incoming().participantIds;
      allow update: if isSignedIn() &&
                       request.auth.uid in existing().participantIds &&
                       incoming().participantIds == existing().participantIds;
      allow delete: if isSignedIn() && request.auth.uid in existing().participantIds;

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isSignedIn() &&
                         incoming().senderId == request.auth.uid &&
                         incoming().text is string && incoming().text.size() >= 1 && incoming().text.size() <= 2000;
        allow update, delete: if isSignedIn() && existing().senderId == request.auth.uid;
      }
    }

    // Test Connection probe endpoint
    match /test/connection {
      allow read, write: if true;
    }
  }
}
