rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Media for posts: posts/{uid}/{postId}/{filename}
    match /posts/{uid}/{postId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Media for stories: stories/{uid}/{storyId}/{filename}
    match /stories/{uid}/{storyId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Avatars / profiles: avatars/{uid}/{filename}
    match /avatars/{uid}/{filename} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Banners: banners/{uid}/{filename}
    match /banners/{uid}/{filename} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
